# x402 v2 / OKX Agent Payments Protocol settings (X Layer · eip155:196).
# Copy into your host's Environment (e.g. Render → Environment). Default is FREE (paywall off).
# For local testing you can `cp .env.example .env` (the .env file is gitignored).

PAYWALL_ENABLED=false

# Network & price — 0.5 USD = 500000 minimal units (6-decimals stablecoin)
PAY_NETWORK=eip155:196
PAY_AMOUNT=500000

# Receiving address (402 challenge payTo) — your Agentic Wallet
PAY_TO_ADDRESS=0xb7338d8e84571de0d032b5fd47f31917523d0e6f

# Stablecoin on X Layer. Default = USD₮0 (USDT). For USDG instead, set both:
#   PAY_ASSET_CONTRACT=0x4ae46a509f6b1d9056937ba4500cb143933d2dc8
#   PAY_EIP712_NAME=Global Dollar
PAY_ASSET_CONTRACT=0x779ded0c9e1022225f8e0630b35a9b54be713736
PAY_EIP712_NAME=USD₮0
PAY_EIP712_VERSION=2
PAY_ASSET_DECIMALS=6
PAY_ASSET_SYMBOL=USDT

# OKX facilitator API auth (standard OKX API key). facilitatorAddress is fetched at runtime
# from /supported, so no need to hard-code it.
OKX_BASE_URL=https://web3.okx.com
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
# Optional static override (normally leave blank — taken from /supported):
OKX_FACILITATOR_ADDRESS=
